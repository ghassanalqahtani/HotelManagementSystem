@model HotelManagementSystem.Domain.Models.UserFile
@{
    var files = ViewBag.Files as List<HotelManagementSystem.Domain.Models.UserFile>;
    ViewData["Title"] = "Manage User Files";
}

<h1>إدارة ملفات المستخدم: @ViewBag.UserName</h1>
<div class="container mt-4">
    <div class="card p-4 mb-4">
        <h5>رفع ملف أو مستند جديد:</h5>
        <hr />
        <form method="post" asp-action="ManageFiles" enctype="multipart/form-data">
            <input type="hidden" asp-for="UserID" />
            <div class="form-group mb-3">
                <label>اسم أو وصف الملف</label>
                <input type="text" asp-for="Name" class="form-control" required />
            </div>
            <div class="form-group mb-3">
                <label>اختر الملف المستندي</label>
                <input type="file" name="fileUser" class="form-control" required />
            </div>
            <div class="form-group">
                <input type="submit" value="Upload & Save" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to Users</a>
            </div>
        </form>
    </div>

    <h3>الملفات والمستندات المرفوعة</h3>
    <hr />
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>اسم الملف</th>
                <th>رابط الملف</th>
            </tr>
        </thead>
        <tbody>
            @if (files != null && files.Any())
            {
                foreach (var file in files)
                {
                    <tr>
                        <td>@file.Id</td>
                        <td>@file.Name</td>
                        <td>
                            <a href="@file.FileURL" target="_blank" class="btn btn-sm btn-link">View / Download File</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-warning text-center">لا توجد ملفات مرفوعة لهذا المستخدم حتى الآن.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
