@model IEnumerable<HotelManagementSystem.Dtos.UserDto>


<div class="container">
    <div class="row pt-4">
        <div class="col-12">
            <h2>قائمة مستخدمي النظام (Users)</h2>
        </div>
    </div>

    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>اسم المستخدم</th>
                <th>البريد الإلكتروني</th>
                <th>العمليات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Id</td>
                        <td>@u.Username</td>
                        <td>@u.Email</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="ManageFiles" asp-route-userId="@u.Id" class="btn btn-sm btn-info" style="color:white; margin-right:5px;">Manage Files</a>
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">لا يوجد مستخدمين مسجلين حالياً.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
