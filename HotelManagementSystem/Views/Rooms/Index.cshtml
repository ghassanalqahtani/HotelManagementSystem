@model IEnumerable<HotelManagementSystem.Dtos.RoomDto>

<div class="container">
    <div class="row pt-4">
        <div class="col-12">
            <h2>قائمة غرف الفندق (Rooms)</h2>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <a asp-action="Create" class="btn btn-primary">Create New Room</a>
        </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>صورة الغرفة</th>
                <th>رقم الغرفة</th>
                <th>نوع الغرفة</th>
                <th>سعر الليلة</th>
                <th>الطابق المربوط</th>
                <th>حالة الغرفة</th>
                <th>UID</th>
                <th>العمليات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.RoomImage))
                            {
                                <img src="@item.RoomImage" style="width: 80px; height: 60px; object-fit: cover; border-radius: 5px;" alt="Room" />
                            }
                            else
                            {
                                <span class="text-muted">لا توجد صورة</span>
                            }
                        </td>
                        <td>@item.RoomNumber</td>
                        <td>@item.RoomType</td>
                        <td>@item.PricePerNight</td>
                        <td>@item.FloorName</td>
                        <td>
                            @if (item.IsAvailable)
                            {
                                @:متاحة
                            }
                            else
                            {
                                @:محجوزة
                            }
                        </td>
                        <td><small class="text-secondary">@item.UID</small></td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-success" style="margin-right:5px;">Edit</a>
                                <a asp-action="ManageImages" asp-route-roomId="@item.Id" class="btn btn-sm btn-info" style="margin-right:5px; color:white;">Manage Photos</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
