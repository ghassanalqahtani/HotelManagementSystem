@model IEnumerable<HotelManagementSystem.Models.Rooms>

<div class="container">
    <div class="row pt-4">
        <div class="col-12">
            <h2>قائمة غرف الفندق (Rooms)</h2>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <a asp-action="Create" class="btn btn-primary">Create New Room</a>
        </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>رقم الغرفة</th>
                <th>نوع الغرفة</th>
                <th>سعر الليلة</th>
                <th>الطابق المربوط</th>
                <th>حالة الغرفة</th>
                <th>العمليات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var r in Model)
                {
                    <tr>
                        <td>@r.Id</td>
                        <td>@r.RoomNumber</td>
                        <td>@r.RoomType</td>
                        <td>@r.PricePerNight</td>
                        <td>@(r.Floor != null ? r.Floor.FloorName : "غير محدد")</td>
                        <td>
                            @if (r.IsAvailable)
                            {
                                @:متاحة
                            }
                            else
                            {
                                @:محجوزة
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-success" style="margin-right:5px;">Edit</a>
                                <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
