@model HotelManagementSystem.Dtos.UpdateRoomDto
@{
    ViewData["Title"] = "Edit Rooms";
}

<h1>Edit Rooms</h1>
<div class="container">
    <form method="post" asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label class="control-label">Room Number</label>
            <input asp-for="RoomNumber" class="form-control" />
        </div>
        <div class="form-group">
            <label class="control-label">Room Type</label>
            <input asp-for="RoomType" class="form-control" />
        </div>
        <div class="form-group">
            <label class="control-label">Price Per Night</label>
            <input asp-for="PricePerNight" class="form-control" />
        </div>
        <div class="form-group">
            <input type="submit" value="Edit" class="btn btn-warning" />
        </div>
    </form>
</div>
