@model HotelManagementSystem.Dtos.RoomDto
@{
    ViewData["Title"] = "Delete Rooms";
}

<h1>Delete Rooms</h1>
<div class="container">
    <form method="post" asp-action="DeleteConfirmed">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label class="control-label">Room Number</label>
            <input asp-for="RoomNumber" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Room Type</label>
            <input asp-for="RoomType" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Price Per Night</label>
            <input asp-for="PricePerNight" class="form-control" readonly />
        </div>
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
