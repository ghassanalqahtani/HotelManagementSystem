@model IEnumerable<HotelManagementSystem.Models.Floors>

<div class="container">
    <div class="row pt-4">
        <div class="col-12">
            <h2>قائمة طوابق الفندق (Floors)</h2>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <a asp-action="Create" class="btn btn-primary">Create New Floor</a>
        </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>اسم الطابق</th>
                <th>رقم الطابق</th>
                <th>العمليات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var f in Model)
                {
                    <tr>
                        <td>@f.Id</td>
                        <td>@f.FloorName</td>
                        <td>@f.FloorNumber</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-success" style="margin-right:5px;">Edit</a>
                                <a asp-action="Delete" asp-route-id="@f.Id" class="btn btn-sm btn-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
