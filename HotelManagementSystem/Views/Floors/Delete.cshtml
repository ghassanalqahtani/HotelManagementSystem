@model HotelManagementSystem.Models.Floors
@{
    ViewData["Title"] = "Delete Floors";
}

<h1>Delete Floors</h1>
<div class="container">
    <form method="post" asp-action="DeleteConfirmed">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label class="control-label">Floor Name</label>
            <input asp-for="FloorName" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Floor Number</label>
            <input asp-for="FloorNumber" class="form-control" readonly />
        </div>
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
