@model HotelManagementSystem.Dtos.CreateFloorDto

<h1>Create Floors</h1>
<div class="container">
    <form method="post" asp-action="Create">
        <div class="form-group">
            <label class="control-label">Floor Name</label>
            <input asp-for="FloorName" class="form-control" />
        </div>
        <div class="form-group">
            <label class="control-label">Floor Number</label>
            <input asp-for="FloorNumber" class="form-control" />
        </div>
        <div class="form-group">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>
    </form>
</div>
