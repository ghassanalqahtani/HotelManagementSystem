@model HotelManagementSystem.Models.Floors
@{
    ViewData["Title"] = "Edit Floors";
}

<h1>Edit Floors</h1>
<div class="container">
    <form method="post" asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label class="control-label">Floor Name</label>
            <input asp-for="FloorName" class="form-control" />
        </div>
        <div class="form-group">
            <label class="control-label">Floor Number</label>
            <input asp-for="FloorNumber" class="form-control" />
        </div>
        <div class="form-group">
            <input type="submit" value="Edit" class="btn btn-warning" />
        </div>
    </form>
</div>
