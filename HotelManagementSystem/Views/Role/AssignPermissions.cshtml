@model IEnumerable<HotelManagementSystem.Domain.Models.Permission>

<div class="container mt-4">
    <h2>تعديل صلاحيات الدور: <span class="text-primary">@ViewBag.RoleName</span></h2>
    <hr />

    <form method="post" asp-controller="Role" asp-action="AssignPermissions">
        <input type="hidden" name="roleId" value="@ViewBag.RoleId" />

        <div class="card p-4 mb-3">
            <h5 class="mb-3">اختر الصلاحيات المتاحة لهذا الدور:</h5>
            <div class="row">
                @if (Model != null)
                {
                    foreach (var permission in Model)
                    {
                        var isChecked = ((List<int>)ViewBag.CurrentPermissionIds).Contains(permission.Id) ? "checked" : null;
                        <div class="col-md-4 mb-2">
                            <div class="form-check border p-2 rounded bg-light">
                                <input class="form-check-input" type="checkbox" name="selectedPermissionIds" value="@permission.Id" id="perm-@permission.Id" checked="@isChecked" style="margin-left: 10px;" />
                                <label class="form-check-label" for="perm-@permission.Id">
                                    @permission.Name
                                </label>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="form-group">
            <button type="submit" class="btn btn-success px-4">حفظ الصلاحيات</button>
            <a asp-controller="Role" asp-action="Index" class="btn btn-secondary px-4">إلغاء</a>
        </div>
    </form>
</div>
