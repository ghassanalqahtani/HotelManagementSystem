@model HotelManagementSystem.Dtos.CustomerDto
@{
    ViewData["Title"] = "Delete Customers";
}

<h1>Delete Customers</h1>
<div class="container">
    <form method="post" asp-action="DeleteConfirmed">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label class="control-label">Name</label>
            <input asp-for="Name" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Email</label>
            <input asp-for="Email" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Phone</label>
            <input asp-for="Phone" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">National ID</label>
            <input asp-for="NationalId" class="form-control" readonly />
        </div>
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
