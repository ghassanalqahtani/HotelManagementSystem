@model HotelManagementSystem.Dtos.CreateBookingDto

<h1>Create Bookings</h1>
<div class="container">
    <form method="post" asp-action="Create">
        <div class="form-group">
            <label class="control-label">Customer ID</label>
            <input asp-for="CustomersId" class="form-control" />
        </div>
        <div class="form-group">
            <label class="control-label">Room ID</label>
            <input asp-for="RoomsId" class="form-control" />
        </div>
        <div class="form-group">
            <label class="control-label">Number Of Nights</label>
            <input asp-for="NumberOfNights" class="form-control" />
        </div>
        <div class="form-group">
            <label class="control-label">Total Price</label>
            <input asp-for="TotalPrice" class="form-control" />
        </div>
        <div class="form-group" style="margin-top:15px;">
            <input type="submit" value="Create" class="btn btn-primary" />
        </div>
    </form>
</div>
