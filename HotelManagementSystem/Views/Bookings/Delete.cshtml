@model HotelManagementSystem.Dtos.BookingDto
@{
    ViewData["Title"] = "Delete Bookings";
}

<h1>Delete Bookings</h1>
<div class="container">
    <form method="post" asp-action="DeleteConfirmed">
        <input type="hidden" asp-for="Id" />
        <div class="form-group">
            <label class="control-label">Customer ID</label>
            <input asp-for="CustomersId" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Room ID</label>
            <input asp-for="RoomsId" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Number Of Nights</label>
            <input asp-for="NumberOfNights" class="form-control" readonly />
        </div>
        <div class="form-group">
            <label class="control-label">Total Price</label>
            <input asp-for="TotalPrice" class="form-control" readonly />
        </div>
        <div class="form-group">
            <input type="submit" value="Delete" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
