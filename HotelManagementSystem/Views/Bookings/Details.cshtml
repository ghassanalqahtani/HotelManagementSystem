@model HotelManagementSystem.Models.Bookings
@{
    ViewData["Title"] = "Booking Details";
}

<h1>Booking Details</h1>
<div class="container">
    <div class="form-group">
        <label class="control-label">Booking ID</label>
        <input asp-for="Id" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label class="control-label">Customer Name</label>
        <input value="@(Model.Customer != null ? Model.Customer.Name : "غير معروف")" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label class="control-label">Room Number</label>
        <input value="@(Model.Room != null ? Model.Room.RoomNumber : "غير معروف")" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label class="control-label">Number Of Nights</label>
        <input asp-for="NumberOfNights" class="form-control" readonly />
    </div>
    <div class="form-group">
        <label class="control-label">Total Price</label>
        <input asp-for="TotalPrice" class="form-control" readonly />
    </div>
    <div class="form-group" style="margin-top:15px;">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
