@model IEnumerable<HotelManagementSystem.Application.Dtos.BookingDto>

<div class="container mt-4">
    <div class="row pt-4 mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2>إدارة حجوزات الغرف (Bookings)</h2>
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createModal">Create New Booking</button>
        </div>
    </div>

    <table class="table table-bordered table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>اسم العميل</th>
                <th>رقم الغرفة</th>
                <th>عدد الليالي</th>
                <th>إجمالي السعر</th>
                <th>العمليات</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var b in Model)
                {
                    <tr>
                        <td>@b.Id</td>
                        <td>@b.CustomerName</td>
                        <td>@b.RoomNumber</td>
                        <td>@b.NumberOfNights</td>
                        <td>@b.TotalPrice</td>
                        <td>
                            <div class="btn-group" role="group">
                                <button class="btn btn-sm btn-info text-white" style="margin-right:5px;" data-bs-toggle="modal" data-bs-target="#detailsModal-@b.Id">Details</button>
                                <button class="btn btn-sm btn-success" style="margin-right:5px;" data-bs-toggle="modal" data-bs-target="#editModal-@b.Id">Edit</button>
                                <button class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@b.Id">Delete</button>
                            </div>
                        </td>
                    </tr>

                    <div class="modal fade" id="detailsModal-@b.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Booking Details</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p><b>Booking ID:</b> @b.Id</p>
                                    <p><b>Customer Name:</b> @b.CustomerName</p>
                                    <p><b>Room Number:</b> @b.RoomNumber</p>
                                    <p><b>Number Of Nights:</b> @b.NumberOfNights</p>
                                    <p><b>Total Price:</b> @b.TotalPrice</p>
                                    <p><b>Security Token (UID):</b> <br /><span class="text-info font-monospace">@b.UID</span></p>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal fade" id="editModal-@b.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form method="post" asp-action="Edit">
                                    <input type="hidden" name="Id" value="@b.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title">Edit Booking</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="form-group mb-3">
                                            <label class="control-label">Select Customer</label>
                                            <select name="CustomersId" class="form-control" required>
                                                @if (ViewBag.CustomersList != null)
                                                {
                                                    foreach (var c in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.CustomersList)
                                                    {
                                                        if (c.Value == b.CustomersId.ToString())
                                                        {
                                                            <option value="@c.Value" selected="selected">@c.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@c.Value">@c.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group mb-3">
                                            <label class="control-label">Select Room</label>
                                            <select name="RoomsId" class="form-control" required>
                                                @if (ViewBag.RoomsListAll != null)
                                                {
                                                    foreach (var r in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.RoomsListAll)
                                                    {
                                                        if (r.Value == b.RoomsId.ToString())
                                                        {
                                                            <option value="@r.Value" selected="selected">@r.Text</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="@r.Value">@r.Text</option>
                                                        }
                                                    }
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group mb-3">
                                            <label class="control-label">Number Of Nights</label>
                                            <input name="NumberOfNights" class="form-control" type="number" value="@b.NumberOfNights" required />
                                        </div>
                                        <div class="form-group mb-3">
                                            <label class="control-label">Total Price</label>
                                            <input name="TotalPrice" class="form-control" type="number" step="0.01" value="@b.TotalPrice" required />
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                        <button type="submit" class="btn btn-success">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade" id="deleteModal-@b.Id" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form method="post" asp-action="DeleteConfirmed">
                                    <input type="hidden" name="Id" value="@b.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title text-danger">Delete Booking</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <p>Are you sure you want to delete this booking?</p>
                                        <hr />
                                        <p><b>Customer Name:</b> @b.CustomerName</p>
                                        <p><b>Room Number:</b> @b.RoomNumber</p>
                                        <p><b>Total Price:</b> @b.TotalPrice</p>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger">Yes, Delete</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </tbody>
    </table>
</div>

<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="Create">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Booking</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group mb-3">
                        <label class="control-label">Select Customer</label>
                        <select name="CustomersId" class="form-control" required>
                            <option value="">-- Choose Customer --</option>
                            @if (ViewBag.CustomersList != null)
                            {
                                foreach (var c in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.CustomersList)
                                {
                                    <option value="@c.Value">@c.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Select Room</label>
                        <select name="RoomsId" class="form-control" required>
                            <option value="">-- Choose Room --</option>
                            @if (ViewBag.RoomsListAvailable != null)
                            {
                                foreach (var r in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.RoomsListAvailable)
                                {
                                    <option value="@r.Value">@r.Text</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Number Of Nights</label>
                        <input name="NumberOfNights" class="form-control" type="number" required />
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Total Price</label>
                        <input name="TotalPrice" class="form-control" type="number" step="0.01" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Booking</button>
                </div>
            </form>
        </div>
    </div>
</div>
